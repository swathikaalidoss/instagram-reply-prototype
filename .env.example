MODE=demo
PORT=8080
# Meta Unified Login. Required only for MODE=live.
# Token scopes: instagram_business_basic, instagram_business_manage_comments,
# instagram_business_manage_messages
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
GRAPH_API_VERSION=v27.0
GRAPH_API_HOST=graph.facebook.com
# One-time owner setup code. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_SETUP_TOKEN=
# Set true when deployed behind HTTPS. Leave false for localhost.
COOKIE_SECURE=false
